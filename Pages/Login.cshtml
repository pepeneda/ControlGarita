@page
@model LoginModel
@{
    ViewData["Title"] = "Acceso al Sistema";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow border-0">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0 fw-bold">Control de Accesos</h4>
                <small class="text-light">Identificación requerida</small>
            </div>

            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
                {
                    <div class="alert alert-danger py-2 text-center" role="alert">
                        @Model.ErrorMensaje
                    </div>
                }

                <!-- Pestañas para elegir modo -->
                <ul class="nav nav-pills nav-fill mb-3" id="tabAcceso" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" id="garita-tab" type="button" onclick="setModo('Garita')">
                            Garita (PIN)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="admin-tab" type="button" onclick="setModo('Supervisor')">
                            Contingencia
                        </button>
                    </li>
                </ul>

                <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <input type="hidden" asp-for="ModoAcceso" id="modoInput" value="Garita" />

                    <!-- Formulario Garita -->
                    <div id="seccion-garita">
                        <div class="mb-3 text-center">
                            <label class="form-label fw-semibold">Introduce el PIN de Puesto</label>
                            <input asp-for="PinGarita" type="password" maxlength="8" class="form-control form-control-lg text-center fs-2 letter-spacing" autofocus />
                        </div>
                    </div>

                    <!-- Formulario Contingencia Supervisor -->
                    <div id="seccion-supervisor" style="display: none;">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Usuario Local</label>
                            <input asp-for="UsuarioAdmin" class="form-control" autocomplete="off" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Contraseña</label>
                            <input asp-for="PasswordAdmin" type="password" class="form-control" />
                        </div>
                        <div class="form-text text-muted mb-3">
                            Uso exclusivo si Active Directory / Dominio no está disponible.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm">
                        Entrar al Sistema
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setModo(modo) {
            document.getElementById("modoInput").value = modo;
            const secGarita = document.getElementById("seccion-garita");
            const secSup = document.getElementById("seccion-supervisor");
            const btnGarita = document.getElementById("garita-tab");
            const btnSup = document.getElementById("admin-tab");

            if (modo === 'Garita') {
                secGarita.style.display = 'block';
                secSup.style.display = 'none';
                btnGarita.classList.add('active');
                btnSup.classList.remove('active');
            } else {
                secGarita.style.display = 'none';
                secSup.style.display = 'block';
                btnGarita.classList.remove('active');
                btnSup.classList.add('active');
            }
        }
    </script>
}